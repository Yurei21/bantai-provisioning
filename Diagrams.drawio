        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#17365D;" value="BANTAI: Conceptual Framework (Input–Process–Output)" vertex="1">
          <mxGeometry height="55" width="1040" x="180" y="25" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#526579;" value="Broadcast-enabled AI Network for Threat and Accident Identification" vertex="1">
          <mxGeometry height="28" width="880" x="260" y="80" as="geometry" />
        </mxCell>
