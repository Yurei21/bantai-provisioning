          <mxGeometry height="570" width="390" x="45" y="145" as="geometry" />
        </mxCell>
        <mxCell id="process_bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F7FAFC;strokeColor=#8AA4BF;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="570" width="390" x="505" y="145" as="geometry" />
        </mxCell>
        <mxCell id="output_bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F7FAFC;strokeColor=#8AA4BF;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="570" width="390" x="965" y="145" as="geometry" />
        </mxCell>
        <mxCell id="input_head" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#17365D;fontColor=#FFFFFF;strokeColor=#17365D;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;" value="INPUT" vertex="1">
          <mxGeometry height="50" width="350" x="65" y="165" as="geometry" />
        </mxCell>
        <mxCell id="process_head" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#17365D;fontColor=#FFFFFF;strokeColor=#17365D;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;" value="PROCESS" vertex="1">
          <mxGeometry height="50" width="350" x="525" y="165" as="geometry" />
        </mxCell>
        <mxCell id="output_head" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#17365D;fontColor=#FFFFFF;strokeColor=#17365D;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;" value="OUTPUT" vertex="1">
          <mxGeometry height="50" width="350" x="985" y="165" as="geometry" />
        </mxCell>
        <mxCell id="input1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#6C8EBF;fontColor=#17365D;fontSize=14;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;1. Video input&lt;/b&gt;&lt;br&gt;• Front and rear IMX219 cameras&lt;br&gt;• H.264 video streams (target: 720p / ~25 FPS each)" vertex="1">
          <mxGeometry height="95" width="340" x="70" y="235" as="geometry" />
        </mxCell>
        <mxCell id="input2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#6C8EBF;fontColor=#17365D;fontSize=14;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;2. Motion / crash input&lt;/b&gt;&lt;br&gt;• ICM-42688-P IMU readings&lt;br&gt;• Acceleration and angular-motion data" vertex="1">
          <mxGeometry height="85" width="340" x="70" y="345" as="geometry" />
        </mxCell>
        <mxCell id="input3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#6C8EBF;fontColor=#17365D;fontSize=14;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;3. Context and connectivity&lt;/b&gt;&lt;br&gt;• Rider/device identity and session status&lt;br&gt;• GPS/location data, mobile data connection&lt;br&gt;• Rider and responder app inputs" vertex="1">
          <mxGeometry height="105" width="340" x="70" y="445" as="geometry" />
        </mxCell>
        <mxCell id="input4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#6C8EBF;fontColor=#17365D;fontSize=14;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;4. System resources&lt;/b&gt;&lt;br&gt;• Raspberry Pi 5 with local rolling buffer&lt;br&gt;• KVM-hosted GPU inference server" vertex="1">
          <mxGeometry height="90" width="340" x="70" y="565" as="geometry" />
        </mxCell>
        <mxCell id="proc1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;fontColor=#274E13;fontSize=14;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;1. Acquire and transmit&lt;/b&gt;&lt;br&gt;Capture front/rear video; maintain local rolling footage; stream compressed video to the KVM when connectivity is available." vertex="1">
          <mxGeometry height="85" width="340" x="530" y="235" as="geometry" />
        </mxCell>
        <mxCell id="proc2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;fontColor=#274E13;fontSize=14;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;2. Detect threats and crashes&lt;/b&gt;&lt;br&gt;• YOLO26s + ByteTrack process video detections/tracks&lt;br&gt;• Threat-event rules assess detected objects/tracks&lt;br&gt;• Deterministic IMU algorithm evaluates crash patterns" vertex="1">
          <mxGeometry height="115" width="340" x="530" y="335" as="geometry" />
        </mxCell>
        <mxCell id="proc3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;fontColor=#274E13;fontSize=14;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;3. Coordinate incident handling&lt;/b&gt;&lt;br&gt;Send event data to the backend; associate time/location; notify rider/responders; allow rider confirmation or cancellation and apply timeout escalation rules." vertex="1">
          <mxGeometry height="100" width="340" x="530" y="465" as="geometry" />
        </mxCell>
        <mxCell id="proc4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;fontColor=#274E13;fontSize=14;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;4. Preserve and record evidence&lt;/b&gt;&lt;br&gt;Save relevant pre-/post-event footage and incident metadata; upload retained clips to Cloudflare R2; log events for review." vertex="1">
          <mxGeometry height="75" width="340" x="530" y="580" as="geometry" />
        </mxCell>
        <mxCell id="out1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#D79B00;fontColor=#7F4120;fontSize=14;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;1. Detection events&lt;/b&gt;&lt;br&gt;Threat alerts and IMU-based crash events with timestamps and available location context." vertex="1">
          <mxGeometry height="80" width="340" x="990" y="235" as="geometry" />
        </mxCell>
        <mxCell id="out2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#D79B00;fontColor=#7F4120;fontSize=14;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;2. Emergency notifications&lt;/b&gt;&lt;br&gt;Rider and responder alerts, confirmation/cancellation status, and timeout-based escalation." vertex="1">
          <mxGeometry height="85" width="340" x="990" y="330" as="geometry" />
        </mxCell>
        <mxCell id="out3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#D79B00;fontColor=#7F4120;fontSize=14;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;3. Evidence and incident records&lt;/b&gt;&lt;br&gt;Preserved video clips, event metadata, and searchable incident logs." vertex="1">
          <mxGeometry height="80" width="340" x="990" y="430" as="geometry" />
        </mxCell>
        <mxCell id="out4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#D79B00;fontColor=#7F4120;fontSize=14;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;4. Response coordination and visibility&lt;/b&gt;&lt;br&gt;Location-aware peer communication, responder coordination, and command-center monitoring through the apps/dashboard." vertex="1">
          <mxGeometry height="100" width="340" x="990" y="525" as="geometry" />
        </mxCell>
        <mxCell id="out5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#D79B00;fontColor=#7F4120;fontSize=14;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;5. Operational fallback&lt;/b&gt;&lt;br&gt;Local rolling footage remains available for later recovery when connectivity is interrupted." vertex="1">
          <mxGeometry height="55" width="340" x="990" y="640" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="input_bg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#44546A;strokeWidth=3;" target="process_bg" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="process_bg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#44546A;strokeWidth=3;" target="output_bg" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="scope" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=13;align=center;verticalAlign=middle;" value="Scope note: visual threat detection is performed on the KVM-hosted AI pipeline; crash detection uses deterministic IMU logic. The IMU data is not an ML input." vertex="1">
          <mxGeometry height="45" width="1170" x="115" y="755" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
